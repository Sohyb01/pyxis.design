{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brainbots": {
    "color": {
      "electric-ultramarine": { "$type": "color", "$value": "#2201FF" },
      "spring-bud": { "$type": "color", "$value": "#AEFF02" },
      "shocking-pink": { "$type": "color", "$value": "#FE06BE" },
      "vivid-yellow": { "$type": "color", "$value": "#FFE600" },
      "vivid-red": { "$type": "color", "$value": "#FE3649" },
      "lavender-indigo": { "$type": "color", "$value": "#A44AFE" },
      "vampire-black": { "$type": "color", "$value": "#0A0A0A" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "font-family": {
      "latin": { "$type": "fontFamily", "$value": "Sora" },
      "arabic": { "$type": "fontFamily", "$value": "Tajawal" }
    },
    "easing": {
      "$description": "Example curves—not an official Brainbots motion standard.",
      "enter": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] },
      "move": { "$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1] }
    }
  }
}
