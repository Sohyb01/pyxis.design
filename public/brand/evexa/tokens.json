{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "evexa": {
    "color": {
      "void-black": { "$type": "color", "$value": "#050505" },
      "signal-white": { "$type": "color", "$value": "#EBEBEB" },
      "blue": { "$type": "color", "$value": "#0032D6" },
      "electric-cyan": { "$type": "color", "$value": "#00BBE0" },
      "system-azure": { "$type": "color", "$value": "#1FA5FF" },
      "graphite": { "$type": "color", "$value": "#474747" },
      "interface-gray": { "$type": "color", "$value": "#8F8F8F" },
      "alert-red": { "$type": "color", "$value": "#FF000D" }
    },
    "font-family": {
      "english-heading": {
        "$type": "fontFamily",
        "$value": ["Mayeka", "sans-serif"]
      },
      "english-body": {
        "$type": "fontFamily",
        "$value": ["DM Sans", "sans-serif"]
      },
      "arabic": {
        "$type": "fontFamily",
        "$value": ["PNU Arabic", "sans-serif"]
      }
    },
    "type-scale": {
      "display": { "size": 48, "lineHeight": 48, "weight": 600 },
      "heading-1": { "size": 40, "lineHeight": 40, "weight": 600 },
      "heading-2": { "size": 30, "lineHeight": 36, "weight": 600 },
      "heading-3": { "size": 24, "lineHeight": 32, "weight": 600 },
      "lead": { "size": 20, "lineHeight": 28, "weight": 600 },
      "body-large": { "size": 18, "lineHeight": 28, "weight": 600 },
      "body": { "size": 16, "lineHeight": 28, "weight": 500 },
      "ui": { "size": 16, "lineHeight": 24, "weight": 500 },
      "detail": { "size": 12, "lineHeight": 14, "weight": 500 }
    },
    "easing": {
      "enter": { "$type": "cubicBezier", "$value": [0.18, 0.9, 0.24, 1] },
      "move": { "$type": "cubicBezier", "$value": [0.76, 0, 0.24, 1] }
    },
    "duration": {
      "enter": { "$type": "duration", "$value": "640ms" },
      "move": { "$type": "duration", "$value": "840ms" }
    },
    "stagger": {
      "enter": { "$type": "duration", "$value": "70ms" },
      "move": { "$type": "duration", "$value": "22ms" }
    }
  }
}
